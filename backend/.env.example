# =============================================================
# PredArb Framework - template de ambiente
# =============================================================
#
# Copie para .env e ajuste. Este arquivo e versionado e NAO
# pode conter segredo algum: sem senha, service-role key, JWT
# secret, private key, seed phrase ou URL de banco com senha.
# Valores sensiveis aparecem apenas como placeholder.
#
# Todo valor abaixo reflete o default seguro de
# app/core/settings.py. As faixas indicadas sao validadas no
# boot: valor fora da faixa impede a aplicacao de subir
# (fail-closed).
#
# Para criar o .env local:
#   Copy-Item -Path .\.env.example -Destination .\.env
# =============================================================


# --- Aplicacao -----------------------------------------------

APP_NAME=PredArb Framework
APP_VERSION=0.1.0

# Em producao mantenha false: DEBUG expoe health interno e
# libera SUPABASE_URL sem HTTPS.
DEBUG=true


# --- Banco de dados principal --------------------------------

DATABASE_URL=sqlite:///predarb.db
DATABASE_ECHO=false


# --- Fase 13B: autenticacao Supabase -------------------------

AUTH_ENABLED=false
# Exige AUTH_ENABLED=true.
AUTH_REQUIRED_FOR_DASHBOARD=false
AUTH_REQUIRE_MFA_FOR_OPERATIONS=true

AUTH_ACCESS_COOKIE_NAME=predarb_access_token
AUTH_REFRESH_COOKIE_NAME=predarb_refresh_token
# Obrigatoriamente true fora de DEBUG.
AUTH_COOKIE_SECURE=true
# strict ou lax.
AUTH_COOKIE_SAMESITE=strict
# Faixa: 3600 a 7776000.
AUTH_REFRESH_COOKIE_MAX_AGE_SECONDS=2592000
AUTH_LOGIN_PATH=/login
AUTH_AFTER_LOGIN_PATH=/dashboard

# Obrigatorias quando AUTH_ENABLED=true. A publishable key e
# publica por definicao; a service-role key NUNCA entra aqui.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256,RS256
# Faixa: 60 a 600.
SUPABASE_JWKS_CACHE_TTL_SECONDS=600


# --- Fase 12A: CORS publico restrito -------------------------

PUBLIC_CORS_ENABLED=false
# Lista separada por virgula. Curinga (*) e recusado.
PUBLIC_CORS_ALLOWED_ORIGINS=
# Bloqueado por invariante nesta fase.
PUBLIC_CORS_ALLOW_CREDENTIALS=false


# --- Ciclo de vida operacional -------------------------------

MOCK_CONNECTOR_ENABLED=true
HYPERLIQUID_CONNECTOR_ENABLED=true
INITIAL_MARKET_SYNC_ENABLED=true
SCHEDULER_ENABLED=true
MARKET_UPDATE_INTERVAL_SECONDS=10
EXECUTION_WORKER_ENABLED=true
ROUTER_DASHBOARD_ENABLED=true


# --- Fase 16: cache e persistencia do Radar Real -------------

# Faixa: 5 a 300 segundos.
REAL_OPPORTUNITY_CACHE_TTL_SECONDS=45

# Quando true, exige REAL_OPPORTUNITY_DATABASE_URL preenchida.
REAL_OPPORTUNITY_PERSISTENCE_ENABLED=false

# Banco DEDICADO das observacoes. Nunca reaproveite a
# DATABASE_URL principal aqui. Em producao e a Session Pooler
# do Supabase, que contem senha e por isso fica somente no
# painel do Render, jamais neste arquivo.
REAL_OPPORTUNITY_DATABASE_URL=

# Faixa: 1 a 1440.
REAL_OPPORTUNITY_PERSISTENCE_HISTORY_LIMIT=60


# --- Fase 17: coletor automatico do Radar Real ---------------

# Exige SCHEDULER_ENABLED=true. A combinacao coletor ligado
# com scheduler desligado impede o boot.
REAL_OPPORTUNITY_BACKGROUND_COLLECTOR_ENABLED=false

# Faixa: 30 a 3600.
REAL_OPPORTUNITY_BACKGROUND_INTERVAL_SECONDS=60
# Faixa: 1 a 100.
REAL_OPPORTUNITY_BACKGROUND_LIMIT_PER_CONNECTOR=20
# Faixa: 0 a 0.25.
REAL_OPPORTUNITY_BACKGROUND_FEE_BUFFER=0.02
# Faixa: 0 a 0.25.
REAL_OPPORTUNITY_BACKGROUND_NEAR_THRESHOLD=0.05
# Faixa: 1 a 20.
REAL_OPPORTUNITY_BACKGROUND_CONCURRENCY=8

# Multiplicador do intervalo que define quando o snapshot
# passa a ser considerado velho. Faixa: 1 a 10.
REAL_OPPORTUNITY_SNAPSHOT_MAX_AGE_MULTIPLIER=3

# Protege Polymarket e Kalshi de coletas encadeadas vindas de
# fora do coletor automatico. Faixa: 0 a 3600, onde 0 desativa
# o throttling por completo.
REAL_OPPORTUNITY_FORCE_REFRESH_COOLDOWN_SECONDS=30


# --- Fase 9F: Shadow Runtime ---------------------------------

SHADOW_RUNTIME_ENABLED=true
# Exige SHADOW_RUNTIME_ENABLED e SCHEDULER_ENABLED.
SHADOW_RUNTIME_SCHEDULER_ENABLED=false
# Minimo: 10.
SHADOW_RUNTIME_INTERVAL_SECONDS=60
SHADOW_RUNTIME_MAX_OPPORTUNITIES_PER_CYCLE=10
SHADOW_RUNTIME_FORCE_REFRESH=false
# INVARIANTE: deve permanecer false.
SHADOW_RUNTIME_PERSIST_AUDIT=false


# --- Hyperliquid: leitura publica ----------------------------

HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_TIMEOUT_SECONDS=10
HYPERLIQUID_MAX_RETRIES=2
HYPERLIQUID_RETRY_DELAY_SECONDS=0.25


# --- Fase 10B: guardrails de execucao Hyperliquid ------------

HYPERLIQUID_TESTNET_API_URL=https://api.hyperliquid-testnet.xyz
HYPERLIQUID_TESTNET_EXECUTION_ENABLED=false
# Exige HYPERLIQUID_TESTNET_EXECUTION_ENABLED=true.
HYPERLIQUID_TESTNET_EXECUTION_AUTHORIZED=false
HYPERLIQUID_TESTNET_MAX_ORDER_NOTIONAL=10

# INVARIANTES: mainnet permanece bloqueada. Qualquer uma
# destas em true impede o boot.
HYPERLIQUID_MAINNET_EXECUTION_ENABLED=false
HYPERLIQUID_MAINNET_EXECUTION_AUTHORIZED=false


# --- Paper Trading (isolado da execucao real) ----------------

PAPER_ACCOUNT_ENABLED=true
PAPER_ACCOUNT_AUTO_LOAD=true
PAPER_ACCOUNT_AUTO_SAVE=true
# Precisa terminar em .json.
PAPER_ACCOUNT_PATH=paper_data/paper_account.json
PAPER_INITIAL_BALANCE=10000

PAPER_SESSION_ENABLED=true
# INVARIANTE: o inicio da sessao exige acao explicita.
PAPER_SESSION_AUTO_START=false
PAPER_SESSION_AUTO_LOAD_REPORT=true
# Minimo: 1.
PAPER_SESSION_INTERVAL_SECONDS=30
PAPER_SESSION_STAKE_AMOUNT=250
PAPER_SESSION_MAX_OPPORTUNITIES_PER_CYCLE=1
PAPER_SESSION_FEE_RATE=0.001
PAPER_SESSION_REPORT_PATH=paper_data/paper_session_report.json


# --- Limites de risco do ambiente Paper ----------------------

PAPER_RISK_ENABLED=true
PAPER_RISK_MAX_TRADE_NOTIONAL=500
PAPER_RISK_MAX_TOTAL_EXPOSURE=2500
PAPER_RISK_MAX_MARKET_EXPOSURE=1000
PAPER_RISK_MAX_OPEN_POSITIONS=10
PAPER_RISK_MAX_DAILY_TRADES=20
PAPER_RISK_DAILY_LOSS_LIMIT=500
# Faixa: maior que 0 e ate 1.
PAPER_RISK_MAX_DRAWDOWN_RATE=0.10
PAPER_RISK_MIN_ROI=0
# Faixa: 0 a 1.
PAPER_RISK_MIN_CONFIDENCE=0
# Faixa: 0 a 100.
PAPER_RISK_MAX_RISK_SCORE=100


# --- IA: analise consultiva ----------------------------------

AI_ENABLED=true
AI_PIPELINE_ENABLED=true
AI_STRICT_FEATURES=false
AI_FAIL_ON_ERROR=false

# INVARIANTES: a IA nunca autoriza ordem por conta propria.
# Qualquer desvio abaixo impede o boot.
AI_ADVISORY_ONLY=true
AI_EXECUTION_AUTHORIZED=false
AI_AUTO_LOAD_MODEL=false

AI_MODEL_NAME=opportunity
AI_MODEL_ROOT=model_artifacts
